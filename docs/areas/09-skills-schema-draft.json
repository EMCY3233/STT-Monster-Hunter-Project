{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STT Area 09 - synthetic skills dataset (draft)",
  "description": "Design-time interchange only. Not a gameplay implementation or a catalogue of commercial game data.",
  "$comment": "No balance values, slot capacities, activation precedence, stacking rules or migration policy are approved. JSON Schema cannot enforce unique IDs or source-to-skill references here; a later semantic validator must do so.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_kind",
    "skills",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "dataset_kind": {
      "const": "synthetic"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "thresholds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/synthetic_id"
          },
          "thresholds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "points",
                "effect_id"
              ],
              "properties": {
                "points": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                },
                "effect_id": {
                  "$ref": "#/$defs/synthetic_id"
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "points"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/synthetic_id"
          },
          "kind": {
            "enum": [
              "armor",
              "decoration",
              "talisman"
            ]
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill_id",
                "value"
              ],
              "properties": {
                "skill_id": {
                  "$ref": "#/$defs/synthetic_id"
                },
                "value": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "synthetic_id": {
      "type": "string",
      "minLength": 11,
      "maxLength": 80,
      "pattern": "^synthetic_[a-z][a-z0-9_]*$"
    }
  }
}
